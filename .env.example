# Bu dosya yalnızca yerel portfolyo demosu için örnek değerler içerir.
# VITE_ ile başlayan değerler tarayıcı paketinde görünür; buraya parola,
# erişim anahtarı, sertifika veya gerçek hasta verisi eklemeyin.
# Bu işaretler şu anda uygulama tarafından zorunlu çalışma zamanı ayarı
# olarak okunmaz; güvenli demo yapılandırması için sözleşmeyi belgeler.

# Uygulamanın gerçek sağlık verileri için tasarlanmadığını arayüzde belirtir.
VITE_ETAKIP_MODE=demo

# Demo kurulumunda gerçek hasta verisi kullanımına izin verilmediğini belirtir.
VITE_ETAKIP_ALLOW_REAL_PATIENT_DATA=false
